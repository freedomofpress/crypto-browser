{
  "name": "@freedomofpress/crypto-browser",
  "version": "0.2.1",
  "description": "Browser-compatible cryptography utilities.",
  "repository": {
    "type": "git",
    "url": "https://github.com/freedomofpress/crypto-browser"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20.19"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:browser": "vitest run --config vite.config.playwright.ts",
    "test:browser:install": "playwright install chromium firefox && node node_modules/playwright-legacy/cli.js install chromium-headless-shell",
    "lint": "eslint . && prettier --check .",
    "lint:fix": "eslint --fix . && prettier --write .",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "cryptography",
    "asn1",
    "encoding",
    "browser",
    "webcrypto",
    "sigstore"
  ],
  "author": "Giulio B. and Sacha Servan-Schreiber",
  "license": "Apache-2.0",
  "dependencies": {
    "@noble/curves": "^2.4.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@vitest/browser-playwright": "^5.0.5",
    "eslint": "^10.14.0",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "playwright": "^1.49.1",
    "playwright-legacy": "npm:playwright-core@1.52.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  },
  "files": [
    "dist"
  ]
}
